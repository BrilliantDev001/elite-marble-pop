
NODE_ENV=development
PORT=5000

# The address of the frontend. Only this website may call the API.
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string, with the database name "elite" before the "?"
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/elite?retryWrites=true&w=majority

# Secret used to sign login sessions. Use a long random value, at least 32 characters.
# Generate one with:  node -p "crypto.randomBytes(48).toString('hex')"
# Keep it private. If it ever leaks, change it (this logs everyone out).
JWT_SECRET=

# Used ONLY by "npm run admin:create" to create or reset the owner account.
# Remove ADMIN_PASSWORD from .env as soon as the script has run.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ImageKit (image hosting). Find these in your ImageKit dashboard under Developer options.
# The PRIVATE key is a secret: never commit it, and never put it in the frontend.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=